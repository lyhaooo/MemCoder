# Model API
MEMCODER_API_KEY=
MEMCODER_MODEL=gpt-5-mini
MEMCODER_BASE_URL=https://api.openai.com/v1
MEMCODER_API_MODE=responses

# Embeddings. Leave the key empty to use the deterministic local embedder.
MEMCODER_EMBEDDING_PROVIDER=local
MEMCODER_EMBEDDING_MODEL=text-embedding-3-small
MEMCODER_EMBEDDING_DIMENSIONS=256

# Runtime
MEMCODER_DB_PATH=.memcoder/memory.sqlite3
MEMCODER_MAX_ATTEMPTS=3
MEMCODER_EXECUTION_TIMEOUT=10
MEMCODER_TOP_K=5
